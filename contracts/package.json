{
  "name": "incentives-contracts",
  "version": "1.0.0",
  "description": "Incentive Token (INC) — Founder Master Vault System on BSC",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy_unified_system.ts --network bsc",
    "deploy:testnet": "hardhat run scripts/deploy_unified_system.ts --network bscTestnet",
    "verify": "hardhat run scripts/verify.ts --network bsc",
    "agent": "node agent/FounderAutonomousAgent.js",
    "collector": "node agent/IncentivesDataCollector.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "@openzeppelin/contracts": "^5.0.0",
    "ethers": "^6.13.0",
    "dotenv": "^16.4.0"
  }
}
